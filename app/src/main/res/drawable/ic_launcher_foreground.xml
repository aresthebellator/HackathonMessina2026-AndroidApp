<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Adaptive launcher icons use a centered, conservative foreground. The system applies the device mask and scale. -->
    <item
        android:width="42dp"
        android:height="42dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_launcher_viking"
            android:gravity="fill" />
    </item>
</layer-list>
